{
  "name": "@outseta/react",
  "version": "0.4.31",
  "description": "React hooks and components for the Outseta API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outseta/outseta-js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && bun build src/index.ts --outdir dist --target browser --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ignore-pattern generated",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@outseta/api-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
