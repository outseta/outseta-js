{
  "name": "@outseta/node-sdk",
  "version": "0.3.21",
  "description": "Node.js SDK for the Outseta API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outseta/outseta-js.git",
    "directory": "packages/node-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && bun build src/index.ts --outdir dist --target node --format esm --packages external",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@outseta/api-client": "workspace:*",
    "jose": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
