{
  "name": "outseta-js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "fetch-spec": "curl --fail --silent --show-error --retry 3 --retry-all-errors --user-agent 'outseta-js-spec-sync/1.0' https://go.outseta.com/swagger/v1/swagger.json -o openapi.json",
    "generate": "bun run fetch-spec && orval && bun scripts/post-generate.mjs",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "prepare": "husky",
    "preinstall": "only-allow pnpm"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "nx": "^20.0.0",
    "only-allow": "^1.2.2",
    "orval": "^7.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
